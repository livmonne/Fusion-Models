# Virtual environment
.venv/

# ARC-AGI-2 dataset (cloned separately)
arc-agi-2/
data/

# Python caches
__pycache__/
*.py[cod]
*.pyo

# mypy / ruff / pytest caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Training outputs (weights, history, plots)
outputs/

# Editor — share workspace settings but ignore everything else in .vscode
.vscode/*
!.vscode/settings.json

# OS junk
.DS_Store
Thumbs.db

# UV lock is fine to commit, but ignore the build artefacts
*.egg-info/
dist/
build/

# Claude Code agent worktrees (local working copies, not project content)
.claude/worktrees/